{
  "name": "ALLTEGBOT",
  "description": "Telegram group tag, welcome, fun and security bot.",
  "keywords": [
    "telegram",
    "bot",
    "group",
    "tagall",
    "moderation"
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "BotFather token",
      "required": true
    },
    "BOT_USERNAME": {
      "description": "Bot username without @",
      "value": ""
    },
    "OWNER_CHAT_ID": {
      "description": "Optional owner Telegram numeric chat/user ID for /start notifications",
      "required": false
    },
    "OWNER_URL": {
      "description": "Owner Telegram URL",
      "value": "https://t.me/"
    },
    "SUPPORT_URL": {
      "description": "Support Telegram URL",
      "value": "https://t.me/"
    },
    "UPDATE_URL": {
      "description": "Updates Telegram URL",
      "value": "https://t.me/"
    },
    "START_IMAGE": {
      "description": "Optional direct image URL or Telegram file_id for /start",
      "value": ""
    },
    "DB_PATH": {
      "description": "SQLite database path",
      "value": "alltegbot.db"
    },
    "MAX_TAG_USERS": {
      "description": "Maximum remembered users per /tagall (1-200)",
      "value": "80"
    },
    "TAG_CHUNK_SIZE": {
      "description": "Users per tag message (1-10)",
      "value": "8"
    },
    "SPAM_WINDOW": {
      "description": "Anti-spam time window in seconds",
      "value": "8"
    },
    "SPAM_MAX_MESSAGES": {
      "description": "Messages allowed in the anti-spam window",
      "value": "6"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1
    }
  }
}
